{
  "name": "dsh-token-usage-sidebar",
  "version": "1.0.1",
  "description": "Persistent Token Usage insights for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y2zyyr/dsh-token-usage-sidebar.git"
  },
  "bugs": {
    "url": "https://github.com/y2zyyr/dsh-token-usage-sidebar/issues"
  },
  "homepage": "https://github.com/y2zyyr/dsh-token-usage-sidebar#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "token-usage"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.6",
    "zod": "4.4.3"
  },
  "license": "MIT"
}
